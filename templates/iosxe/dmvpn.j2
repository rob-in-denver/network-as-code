{% if device.role == 'hub' %}
{% for spoke in dmvpn.spokes %}
ip prefix-list PFX-{{ spoke.hostname }} seq 10 permit {{ spoke.lan_prefix }}
ip prefix-list GW-{{ spoke.hostname }} seq 10 permit {{ spoke.tunnel_address }}/32
{% endfor %}
{% else %}
ip prefix-list LAN-OUT seq 10 permit {{ device.lan_prefix }}
{% endif %}
!
interface {{ device.wan_interface }}
 description WAN underlay in {{ dmvpn.fvrf }}
 vrf forwarding {{ dmvpn.fvrf }}
 ip address {{ device.wan_address }} {{ device.wan_mask }}
 no shutdown
