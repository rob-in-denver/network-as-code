{% if device.role == 'hub' %}
 ip nhrp map multicast dynamic
 ip nhrp redirect
{% else %}
{% for hub in dmvpn.hubs %}
 ip nhrp map {{ hub.tunnel_address }} {{ hub.nbma }}
 ip nhrp map multicast {{ hub.nbma }}
 ip nhrp nhs {{ hub.tunnel_address }}
{% endfor %}
 ip nhrp shortcut
 ip nhrp redirect
{% endif %}
 tunnel source {{ device.wan_interface }}
 tunnel mode gre multipoint
 tunnel vrf {{ dmvpn.fvrf }}
 tunnel protection ipsec profile {{ dmvpn.ipsec.profile }}
