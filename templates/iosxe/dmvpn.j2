interface {{ device.lan_interface }}
 description {{ dmvpn.ivrf }} LAN
 vrf forwarding {{ dmvpn.ivrf }}
 ip address {{ device.lan_address }} {{ device.lan_mask }}
 no shutdown
!
interface Tunnel0
 description DMVPN phase {{ dmvpn.phase }} {{ device.role }}
 vrf forwarding {{ dmvpn.ivrf }}
 ip address {{ device.tunnel_address }} {{ dmvpn.tunnel_mask }}
 no ip redirects
 ip mtu {{ dmvpn.mtu }}
 ip tcp adjust-mss {{ dmvpn.mss }}
 ip nhrp network-id {{ dmvpn.nhrp.network_id }}
 ip nhrp authentication {{ dmvpn.psk_placeholder }}
