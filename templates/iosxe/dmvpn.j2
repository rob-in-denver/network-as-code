 address-family ipv4 unicast vrf {{ dmvpn.ivrf }} autonomous-system {{ dmvpn.eigrp.asn }}
  af-interface default
   passive-interface
  exit-af-interface
  af-interface Tunnel0
   no passive-interface
{% if device.role == 'hub' %}
   no next-hop-self
   no split-horizon
{% else %}
   distribute-list prefix LAN-OUT out
{% endif %}
  exit-af-interface
{% if device.role == 'hub' %}
  topology base
{% for spoke in dmvpn.spokes %}
   distribute-list prefix PFX-{{ spoke.hostname }} gateway GW-{{ spoke.hostname }} in
{% endfor %}
  exit-af-topology
{% endif %}
{% for net in device.eigrp_networks %}
  network {{ net.network }} {{ net.wildcard }}
{% endfor %}
 exit-address-family
