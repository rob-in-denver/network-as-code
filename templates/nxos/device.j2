! Generated by network-as-code from data/fabric.yml
! Do not edit by hand. Re-render with playbooks/render.yml.
!
hostname {{ device.hostname }}
!
{% set site = fabric.sites | selectattr('id', 'equalto', device.site) | first %}
feature ospf
feature bgp
{% if device.role in ['leaf', 'bgw'] %}
feature interface-vlan
feature vn-segment-vlan-based
feature nv overlay
{% endif %}
nv overlay evpn
{% if device.role == 'leaf' %}

fabric forwarding anycast-gateway-mac {{ fabric.anycast_gateway_mac }}
{% endif %}
{% if device.role == 'bgw' %}

evpn multisite border-gateway {{ site.multisite_id }}
  delay-restore time 300
{% endif %}
{% if device.role in ['leaf', 'bgw'] %}
{% for vni in fabric.vnis %}

vlan {{ vni.vlan }}
  name {{ vni.name }}
  vn-segment {{ vni.id }}
{% endfor %}
{% for vrf in fabric.vrfs %}

vrf context {{ vrf.name }}
  vni {{ vrf.vni }}
  rd auto
  address-family ipv4 unicast
    route-target both auto
    route-target both auto evpn
{% endfor %}
{% endif %}

interface loopback0
  description router-id
  ip address {{ device.router_id }}/32
  ip router ospf {{ fabric.ospf_process }} area {{ fabric.ospf_area }}
{% if device.vtep is defined %}

interface loopback1
  description vtep
  ip address {{ device.vtep }}/32
  ip router ospf {{ fabric.ospf_process }} area {{ fabric.ospf_area }}
{% endif %}
{% if device.role == 'bgw' %}

interface loopback100
  description multisite-vip
  ip address {{ site.multisite_vip }}/32
  ip router ospf {{ fabric.ospf_process }} area {{ fabric.ospf_area }}
{% endif %}
{% for iface in device.interfaces %}

interface {{ iface.name }}
  description {{ iface.description }}
  no switchport
  mtu {{ fabric.mtu }}
  no shutdown
{% if iface.role == 'underlay' %}
  ip address {{ iface.address }}/{{ iface.prefix }}
  ip ospf network point-to-point
  no ip ospf passive-interface
  ip router ospf {{ fabric.ospf_process }} area {{ fabric.ospf_area }}
{% elif iface.role == 'dci' %}
  evpn multisite dci-tracking
  ip address {{ iface.address }}/{{ iface.prefix }}
{% endif %}
{% endfor %}
{% if device.role == 'leaf' %}
{% for port in device.host_ports | default([]) %}

interface {{ port.name }}
  description {{ port.description }}
  switchport
  switchport mode access
  switchport access vlan {{ port.vlan }}
  spanning-tree port type edge
  no shutdown
{% endfor %}
{% for vni in fabric.vnis if vni.type == 'l2' %}

interface Vlan{{ vni.vlan }}
  description anycast-gateway {{ vni.name }}
  no shutdown
  vrf member {{ vni.vrf }}
  ip address {{ vni.gateway }}/{{ vni.prefix }}
  fabric forwarding mode anycast-gateway
{% endfor %}
{% endif %}
{% if device.vtep is defined %}

interface nve1
  no shutdown
  host-reachability protocol bgp
  source-interface loopback1
{% if device.role == 'bgw' %}
  multisite border-gateway interface loopback100
{% endif %}
{% for vni in fabric.vnis %}
{% if vni.type == 'l2' %}
  member vni {{ vni.id }}
{% if device.role == 'bgw' %}
    multisite ingress-replication
{% endif %}
    ingress-replication protocol bgp
{% else %}
  member vni {{ vni.id }} associate-vrf
{% endif %}
{% endfor %}

evpn
{% for vni in fabric.vnis if vni.type == 'l2' %}
  vni {{ vni.id }} l2
    rd auto
    route-target import auto
    route-target export auto
{% endfor %}
{% endif %}

router ospf {{ fabric.ospf_process }}
  router-id {{ device.router_id }}
  passive-interface default

router bgp {{ site.asn }}
  router-id {{ device.router_id }}
  address-family ipv4 unicast
  address-family l2vpn evpn
{% if device.role == 'spine' %}
    retain route-target all
{% endif %}
{% if device.role == 'spine' %}
{% for client in fabric.devices if client.site == device.site and client.role != 'spine' %}
  neighbor {{ client.router_id }}
    remote-as {{ site.asn }}
    description {{ client.hostname }}
    update-source loopback0
    address-family l2vpn evpn
      send-community
      send-community extended
      route-reflector-client
{% endfor %}
{% elif device.role in ['leaf', 'bgw'] %}
{% for spine in fabric.devices if spine.site == device.site and spine.role == 'spine' %}
  neighbor {{ spine.router_id }}
    remote-as {{ site.asn }}
    description {{ spine.hostname }}
    update-source loopback0
    address-family l2vpn evpn
      send-community
      send-community extended
{% endfor %}
{% endif %}
{% if device.role == 'bgw' %}
{% for iface in device.interfaces if iface.role == 'dci' %}
  neighbor {{ iface.peer_address }}
    remote-as {{ iface.peer_as }}
    description {{ iface.description }}
    update-source {{ iface.name }}
    address-family l2vpn evpn
      send-community
      send-community extended
      rewrite-evpn-rt-asn
{% endfor %}
{% endif %}
!
end
